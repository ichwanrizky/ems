// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model menu_group {
  id         Int      @id @default(autoincrement())
  menu_group String   @unique
  urut       Int?
  group      Boolean?
  parent_id  String?
  menu       menu[]

  @@index([menu_group, urut, parent_id])
}

model menu {
  id            Int        @id @default(autoincrement())
  menu          String?
  path          String?
  last_path     String?
  urut          Int?
  menu_group_id Int
  menu_group    menu_group @relation(fields: [menu_group_id], references: [id])
  access        access[]

  @@index([urut, menu_group_id])
}

model roles {
  id                    Int                     @id @default(autoincrement())
  role_name             String                  @unique
  access_department     access_department[]
  access_sub_department access_sub_department[]
  access                access[]
  user                  user[]
}

model department {
  id                    Int                     @id @default(autoincrement())
  nama_department       String                  @unique
  latitude              String?
  longitude             String?
  radius                String?
  created_at            DateTime?               @db.DateTime(0)
  is_deleted            Boolean                 @default(false)
  sub_department        sub_department[]
  access_department     access_department[]
  akses_izin_department akses_izin_department[]
  department_location   department_location[]
  shift                 shift[]
  pegawai               pegawai[]
  pengajuan_izin        pengajuan_izin[]
  izin                  izin[]
  tanggal_merah         tanggal_merah[]
  pengajuan_overtime    pengajuan_overtime[]
  overtime              overtime[]
  komponen_gaji         komponen_gaji[]
  adjustment            adjustment[]
  gaji_pegawai          gaji_pegawai[]
  pph21                 pph21[]
  thr                   thr[]
}

model department_location {
  id            Int        @id @default(autoincrement())
  nama_lokasi   String?
  latitude      String
  longitude     String
  radius        String
  department_id Int
  department    department @relation(fields: [department_id], references: [id])

  @@index([department_id])
}

model sub_department {
  id                    Int                     @id @default(autoincrement())
  nama_sub_department   String                  @unique
  created_at            DateTime?               @db.DateTime(0)
  is_deleted            Boolean                 @default(false)
  department_id         Int
  department            department              @relation(fields: [department_id], references: [id])
  leader                Int?
  leader_user           user?                   @relation("leader_user", fields: [leader], references: [id])
  supervisor            Int?
  supervisor_user       user?                   @relation("supervisor_user", fields: [supervisor], references: [id])
  manager               Int?
  manager_user          user?                   @relation("manager_user", fields: [manager], references: [id])
  access_sub_department access_sub_department[]
  pegawai               pegawai[]
  akses_izin            akses_izin[]
  pengajuan_overtime    pengajuan_overtime[]
}

model jenis_izin {
  kode                  String                  @id @unique
  jenis                 String
  is_jam                Boolean                 @default(false)
  akses_izin            akses_izin[]
  akses_izin_department akses_izin_department[]
  pengajuan_izin        pengajuan_izin[]
  izin                  izin[]
}

model akses_izin {
  id                Int            @id @default(autoincrement())
  sub_department_id Int
  sub_department    sub_department @relation(fields: [sub_department_id], references: [id])
  jenis_izin_kode   String
  jenis_izin        jenis_izin     @relation(fields: [jenis_izin_kode], references: [kode])
}

model akses_izin_department {
  id              Int        @id @default(autoincrement())
  department_id   Int
  department      department @relation(fields: [department_id], references: [id])
  jenis_izin_kode String
  jenis_izin      jenis_izin @relation(fields: [jenis_izin_kode], references: [kode])

  @@unique([department_id, jenis_izin_kode])
}

model access_department {
  role_id       Int
  roles         roles      @relation(fields: [role_id], references: [id])
  department_id Int
  department    department @relation(fields: [department_id], references: [id])

  @@id([role_id, department_id])
}

model access_sub_department {
  role_id           Int
  roles             roles          @relation(fields: [role_id], references: [id])
  sub_department_id Int
  sub_department    sub_department @relation(fields: [sub_department_id], references: [id])

  @@id([role_id, sub_department_id])
}

model access {
  role_id Int
  roles   roles   @relation(fields: [role_id], references: [id])
  menu_id Int
  menu    menu    @relation(fields: [menu_id], references: [id])
  view    Boolean @default(false)
  insert  Boolean @default(false)
  update  Boolean @default(false)
  delete  Boolean @default(false)

  @@id([role_id, menu_id])
}

model user {
  id                 Int                  @id @default(autoincrement())
  username           String               @unique
  password           String
  name               String?
  telp               String?
  role_id            Int?
  roles              roles?               @relation(fields: [role_id], references: [id])
  created_at         DateTime?            @db.DateTime(0)
  is_deleted         Boolean              @default(false)
  pegawai_id         Int?
  is_userluar        Boolean              @default(false)
  pegawai            pegawai?             @relation(fields: [pegawai_id], references: [id])
  leader_user        sub_department[]     @relation("leader_user")
  supervisor_user    sub_department[]     @relation("supervisor_user")
  manager_user       sub_department[]     @relation("manager_user")
  pengajuan_izin     pengajuan_izin[]     @relation("user_approved")
  session_mobile     session_mobile[]
  pengajuan_overtime pengajuan_overtime[]

  @@index([username], map: "user_username")
  @@index([role_id], map: "user_role_id")
}

model session_mobile {
  id         Int       @id @default(autoincrement())
  token      String    @unique @db.VarChar(500)
  created_at DateTime? @db.DateTime(0)
  expired    Boolean   @default(false)
  user_id    Int
  user       user      @relation(fields: [user_id], references: [id])

  @@unique([user_id, token])
}

model shift {
  id            Int        @id @default(autoincrement())
  jam_masuk     DateTime?  @db.Time(0)
  jam_pulang    DateTime?  @db.Time(0)
  keterangan    String?
  different_day Boolean    @default(false)
  cond_friday   Int        @default(0)
  department_id Int
  department    department @relation(fields: [department_id], references: [id])
  pegawai       pegawai[]
  absen         absen[]
}

model pegawai {
  id                         Int                          @id @default(autoincrement())
  panji_id                   String?
  nama                       String
  nik_ktp                    String
  tmp_lahir                  String?
  tgl_lahir                  DateTime?                    @db.Date
  jk                         String
  agama                      String?
  kebangsaan                 String?
  alamat                     String?
  rt                         String?
  rw                         String?
  kel                        String?
  kec                        String?
  kota                       String?
  telp                       String
  status_nikah               String
  email                      String?
  position                   String?
  npwp                       String?
  jenis_bank                 String?
  no_rek                     String?
  bpjs_tk                    String?
  bpjs_kes                   String?
  is_active                  Boolean                      @default(true)
  is_deleted                 Boolean                      @default(false)
  type_gaji                  String                       @default("nonfixed")
  is_overtime                Boolean                      @default(false)
  is_tax                     Boolean                      @default(true)
  tgl_join                   DateTime?                    @db.Date
  department_id              Int
  department                 department                   @relation(fields: [department_id], references: [id])
  sub_department_id          Int?
  sub_department             sub_department?              @relation(fields: [sub_department_id], references: [id])
  shift_id                   Int?
  shift                      shift?                       @relation(fields: [shift_id], references: [id])
  user                       user[]
  pegawai_history            pegawai_history[]
  absen                      absen[]
  pengajuan_izin             pengajuan_izin[]
  izin                       izin[]
  request_session_izin       request_session_izin[]
  pengajuan_overtime_pegawai pengajuan_overtime_pegawai[]
  overtime                   overtime[]
  master_gaji_pegawai        master_gaji_pegawai[]
  adjustment                 adjustment[]
  gaji_pegawai               gaji_pegawai[]
  gaji                       gaji[]
  pph21                      pph21[]
  thr                        thr[]
  pegawai_location           pegawai_location[]
}

model pegawai_location {
  id          Int     @id @default(autoincrement())
  nama_lokasi String?
  latitude    String
  longitude   String
  radius      String
  pegawai_id  Int
  pegawai     pegawai @relation(fields: [pegawai_id], references: [id])

  @@index([pegawai_id])
}

model pegawai_history {
  id         Int                   @id @default(autoincrement())
  pegawai_id Int
  pegawai    pegawai               @relation(fields: [pegawai_id], references: [id])
  tanggal    DateTime              @db.Date
  jenis      pegawai_history_jenis
}

enum pegawai_history_jenis {
  JOIN
  REGISN
}

model absen {
  id           Int       @id @default(autoincrement())
  tanggal      DateTime? @db.Date()
  absen_masuk  DateTime? @db.Time()
  absen_pulang DateTime? @db.Time()
  late         Int       @default(0)
  early        Int       @default(0)
  bulan        Int
  tahun        Int
  latitude     String?
  longitude    String?
  ket_masuk    String?
  ket_pulang   String?
  is_manual    Boolean   @default(false)
  pegawai_id   Int
  pegawai      pegawai   @relation(fields: [pegawai_id], references: [id])
  shift_id     Int?
  shift        shift?    @relation(fields: [shift_id], references: [id])

  @@unique([pegawai_id, tanggal])
}

model pengajuan_izin {
  id              Int        @id @default(autoincrement())
  uuid            String     @unique @default(uuid())
  jenis_izin_kode String
  jenis_izin      jenis_izin @relation(fields: [jenis_izin_kode], references: [kode])
  tanggal         DateTime?  @db.Date
  pegawai_id      Int
  pegawai         pegawai    @relation(fields: [pegawai_id], references: [id])
  status          Int        @default(0)
  bulan           Int
  tahun           Int
  keterangan      String?
  jumlah_hari     String?
  jumlah_jam      String?
  approve_by      Int?
  approve_date    DateTime?  @db.DateTime(0)
  user_approved   user?      @relation("user_approved", fields: [approve_by], references: [id])
  department_id   Int
  department      department @relation(fields: [department_id], references: [id])
  izin            izin[]
}

model izin {
  id                Int            @id @default(autoincrement())
  jenis_izin_kode   String
  jenis_izin        jenis_izin     @relation(fields: [jenis_izin_kode], references: [kode])
  tanggal           DateTime       @db.Date
  pegawai_id        Int
  pegawai           pegawai        @relation(fields: [pegawai_id], references: [id])
  bulan             Int
  tahun             Int
  keterangan        String?
  jumlah_hari       String?
  jumlah_jam        String?
  pengajuan_izin_id Int
  pengajuan_izin    pengajuan_izin @relation(fields: [pengajuan_izin_id], references: [id])
  department_id     Int
  department        department     @relation(fields: [department_id], references: [id])

  @@unique([pegawai_id, tanggal, jenis_izin_kode])
}

model request_session_izin {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(uuid())
  pegawai_id Int
  pegawai    pegawai   @relation(fields: [pegawai_id], references: [id])
  created_at DateTime? @db.DateTime(0)
  expired_at DateTime? @db.DateTime(0)
  expired    Boolean   @default(false)

  @@index([uuid], map: "request_session_izin_uuid")
}

model tanggal_merah {
  id                 Int                  @id @default(autoincrement())
  bulan              Int
  tahun              Int
  department_id      Int
  department         department           @relation(fields: [department_id], references: [id])
  tanggal_merah_list tanggal_merah_list[]

  @@unique([department_id, bulan, tahun])
}

model tanggal_merah_list {
  id               Int           @id @default(autoincrement())
  tanggal          DateTime?     @db.Date
  tanggal_merah_id Int
  tanggal_nomor    String
  tanggal_merah    tanggal_merah @relation(fields: [tanggal_merah_id], references: [id])
}

model pengajuan_overtime {
  id                         Int                          @id @default(autoincrement())
  tanggal                    DateTime                     @db.Date
  jam_from                   DateTime                     @db.Time(0)
  jam_to                     DateTime                     @db.Time(0)
  department_id              Int
  department                 department                   @relation(fields: [department_id], references: [id])
  sub_department_id          Int
  sub_department             sub_department               @relation(fields: [sub_department_id], references: [id])
  job_desc                   String?
  remark                     String?
  status                     Int                          @default(0)
  bulan                      Int
  tahun                      Int
  approve_by                 Int?
  user                       user?                        @relation(fields: [approve_by], references: [id])
  approve_date               DateTime?                    @db.DateTime(0)
  pengajuan_overtime_pegawai pengajuan_overtime_pegawai[]
  overtime                   overtime[]
}

model pengajuan_overtime_pegawai {
  id                    Int                @id @default(autoincrement())
  pengajuan_overtime_id Int
  pengajuan_overtime    pengajuan_overtime @relation(fields: [pengajuan_overtime_id], references: [id])
  pegawai_id            Int
  pegawai               pegawai            @relation(fields: [pegawai_id], references: [id])

  @@unique([pengajuan_overtime_id, pegawai_id])
}

model overtime {
  id                    Int                @id @default(autoincrement())
  tanggal               DateTime           @db.Date
  pegawai_id            Int
  pegawai               pegawai            @relation(fields: [pegawai_id], references: [id])
  department_id         Int
  department            department         @relation(fields: [department_id], references: [id])
  jam                   String?
  total                 String?
  is_holiday            Boolean            @default(false)
  status                Int                @default(0)
  bulan                 Int
  tahun                 Int
  pengajuan_overtime_id Int
  pengajuan_overtime    pengajuan_overtime @relation(fields: [pengajuan_overtime_id], references: [id])
}

model komponen_gaji {
  id                  Int                   @id @default(autoincrement())
  komponen            String?
  tipe                String?
  metode              String?
  is_master           Boolean               @default(false)
  urut                Int?
  urut_tampil         Int?
  is_gaji             Boolean               @default(false)
  department_id       Int
  department          department            @relation(fields: [department_id], references: [id])
  master_gaji_pegawai master_gaji_pegawai[]
}

model master_gaji_pegawai {
  id          Int           @id @default(autoincrement())
  komponen_id Int
  komponen    komponen_gaji @relation(fields: [komponen_id], references: [id])
  pegawai_id  Int
  pegawai     pegawai       @relation(fields: [pegawai_id], references: [id])
  nominal     Int

  @@unique([komponen_id, pegawai_id])
}

model adjustment {
  id            Int        @id @default(autoincrement())
  bulan         Int
  tahun         Int
  pegawai_id    Int
  pegawai       pegawai    @relation(fields: [pegawai_id], references: [id])
  nominal       Int        @default(0)
  keterangan    String?
  jenis         String?
  department_id Int
  department    department @relation(fields: [department_id], references: [id])
}

model gaji_pegawai {
  id            Int        @id @default(autoincrement())
  uuid          String     @unique @default(uuid())
  bulan         Int
  tahun         Int
  pegawai_id    Int
  pegawai       pegawai    @relation(fields: [pegawai_id], references: [id])
  nominal       Int        @default(0)
  publish       Boolean    @default(false)
  gaji          gaji[]
  department_id Int
  department    department @relation(fields: [department_id], references: [id])
}

model gaji {
  id              Int          @id @default(autoincrement())
  bulan           Int
  tahun           Int
  pegawai_id      Int
  pegawai         pegawai      @relation(fields: [pegawai_id], references: [id])
  tipe            String?
  komponen        String?
  komponen_id     Int?
  nominal         String       @default("0")
  urut            Int
  gaji_pegawai_id Int
  gaji_pegawai    gaji_pegawai @relation(fields: [gaji_pegawai_id], references: [id])
}

model pph21 {
  id            Int        @id @default(autoincrement())
  bulan         Int
  tahun         Int
  department_id Int
  department    department @relation(fields: [department_id], references: [id])
  pegawai_id    Int
  pegawai       pegawai    @relation(fields: [pegawai_id], references: [id])
  gaji          Int        @default(0)
  pph21         Int        @default(0)
}

model thr {
  id            Int        @id @default(autoincrement())
  uuid          String     @unique @default(uuid())
  bulan         Int
  tahun         Int
  department_id Int
  department    department @relation(fields: [department_id], references: [id])
  pegawai_id    Int
  pegawai       pegawai    @relation(fields: [pegawai_id], references: [id])
  thr           Int        @default(0)
  pph21         Int        @default(0)
  net_thr       Int        @default(0)
}

// ============================================================================
// SALES
// ============================================================================
// Penawaran harga (quotation) ke customer, beserta master customernya.
// Modul ini murni dokumen — tidak menyentuh perhitungan gaji/absensi mana pun.

// Memetakan `tb_customer` milik sistempanji satu lawan satu (kode, nama,
// alamat, telp), ditambah `email` yang memang hanya ada di EMS.
//
// `kode` UNIQUE di sini padahal di sistem asal boleh berulang — lihat
// `ems_backend/database/migrasi-customer-sistempanji.sql` untuk daftar kode
// yang diberi angka saat impor.
model customer {
  id            Int         @id @default(autoincrement())
  kode          String      @unique
  nama_customer String
  alamat        String?     @db.Text
  telp          String?
  email         String?
  created_at    DateTime?   @db.DateTime(0)
  is_deleted    Boolean     @default(false)
  quotation     quotation[]
  po_masuk      po_masuk[]
  po_keluar     po_keluar[]

  @@index([nama_customer])
}

// Header penawaran. Nominalnya DECIMAL (bukan Int seperti gaji) karena qty
// boleh pecahan — 1,5 bulan jasa × harga satuan tidak bulat ke rupiah.
//
// TIDAK punya siklus hidup: tidak ada draft/terkirim/disetujui, tidak ada
// jejak perpindahan status, dan tidak ada penawaran yang "menggantikan"
// penawaran lain. Penawaran dikirim lewat email atau WhatsApp di luar aplikasi
// ini, dan status yang harus dipelihara tangan selalu berakhir bohong: tidak
// ada yang kembali ke sini untuk menandai "sudah dikirim". Yang tersisa cuma
// dokumennya — dibuat, diubah, dicetak, dihapus — dan satu keadaan yang bisa
// dihitung sendiri tanpa ada yang mengisinya: `berlaku_sampai` yang sudah
// lewat.
model quotation {
  id                    Int                @id @default(autoincrement())
  uuid                  String             @unique @default(uuid())
  nomor                 String             @unique
  // Diisi tangan, 0 = bukan revisi. Bukan hitungan sistem: yang menentukan
  // sebuah penawaran itu "revisi ke-2" adalah kesepakatan dengan customer di
  // luar aplikasi ini, bukan tombol di sini.
  revisi                Int                @default(0)
  tanggal               DateTime           @db.Date
  berlaku_sampai        DateTime           @db.Date
  customer_id           Int
  customer              customer           @relation(fields: [customer_id], references: [id])
  attn                  String?
  perihal               String
  syarat_pembayaran     String?            @db.Text
  catatan               String?            @db.Text
  subtotal              Decimal            @default(0) @db.Decimal(18, 2)
  diskon_persen         Decimal            @default(0) @db.Decimal(5, 2)
  diskon_nominal        Decimal            @default(0) @db.Decimal(18, 2)
  dpp                   Decimal            @default(0) @db.Decimal(18, 2)
  ppn_persen            Decimal            @default(0) @db.Decimal(5, 2)
  ppn_nominal           Decimal            @default(0) @db.Decimal(18, 2)
  // PPh dipotong customer, jadi ia PENGURANG: total = dpp + ppn - pph.
  // `pph_dasar`: "item" = hanya item yang dicentang; "total" = seluruh dpp.
  pph_persen            Decimal            @default(0) @db.Decimal(5, 2)
  pph_dasar             String             @default("item")
  pph_nominal           Decimal            @default(0) @db.Decimal(18, 2)
  total                 Decimal            @default(0) @db.Decimal(18, 2)
  // Penawaran berisi beberapa PILIHAN tidak punya grand total yang bermakna:
  // yang tampil hanya subtotal tiap grup. Lihat catatan di QuotationController.
  tampilkan_grand_total Boolean            @default(true)
  // Mata uang dokumen — penentu simbol yang tercetak di PDF, BUKAN kurs:
  // nominalnya disimpan apa adanya dalam mata uang ini, tidak pernah
  // dikonversi. Sebagian besar penawaran IDR; USD/SGD dipakai untuk customer
  // luar negeri.
  currency              String             @default("IDR")
  // Penanda tangan yang tercetak di blok tanda tangan PDF. Opsional: ratusan
  // penawaran lama tidak punya, dan yang kosong tercetak seperti dulu — ruang
  // kosong untuk teken basah, dengan nama pembuat di bawah garis.
  ttd_id                Int?
  ttd                   ttd?               @relation(fields: [ttd_id], references: [id])
  created_by            Int?
  created_at            DateTime?          @db.DateTime(0)
  updated_at            DateTime?          @db.DateTime(0)
  is_deleted            Boolean            @default(false)
  quotation_item        quotation_item[]
  quotation_grup        quotation_grup[]
  quotation_gambar      quotation_gambar[]
  po_masuk              po_masuk[]

  @@index([tanggal])
  @@index([customer_id])
  @@index([ttd_id])
}

/// Sales > Tanda Tangan — master orang yang berhak meneken dokumen.
///
/// Dibuat sekali, lalu DIPILIH berulang kali oleh quotation dan po_keluar;
/// yang menyusun dokumen tidak menggambar apa pun. Ini yang menggantikan
/// praktik cetak → teken tangan → pindai ulang.
///
/// Gambarnya TIDAK di sini. Sama seperti quotation_gambar dan po_berkas,
/// berkasnya ada di luar document root backend (`storage/ttd/<uuid>.png`) dan
/// `uuid` di baris ini yang menunjuk ke sana — jadi mengganti gambar berarti
/// mengganti uuid-nya juga, dan cache browser tidak perlu dipikirkan.
model ttd {
  id         Int         @id @default(autoincrement())
  /// Nama berkas gambarnya, bukan identitas barisnya — lihat catatan model.
  uuid       String      @unique @default(uuid())
  nama       String
  /// Tercetak kecil di bawah nama. Opsional: sebagian penanda tangan cukup
  /// dikenal dengan namanya saja.
  jabatan    String?
  created_by Int?
  created_at DateTime?   @db.DateTime(0)
  updated_at DateTime?   @db.DateTime(0)
  is_deleted Boolean     @default(false)
  quotation  quotation[]
  po_keluar  po_keluar[]

  @@index([is_deleted])
}

model quotation_item {
  id                    Int                     @id @default(autoincrement())
  quotation_id          Int
  quotation             quotation               @relation(fields: [quotation_id], references: [id], onDelete: Cascade)
  grup_id               Int?
  grup                  quotation_grup?         @relation(fields: [grup_id], references: [id], onDelete: SetNull)
  urut                  Int
  /// Baris ini JUDUL, bukan barang: hanya `deskripsi` yang berarti, dan qty /
  /// harga / jumlah dipaksa nol supaya ia tidak pernah ikut penjumlahan.
  ///
  /// Ada karena penawaran nyata sering butuh penanda bagian di tengah daftar
  /// ("Pengadaan Sembako", lalu barangnya). Sistem lama tidak punya ini, jadi
  /// orang menyiasatinya dengan item berharga Rp 0 — yang tetap dihitung, tetap
  /// bernomor, dan tetap memakan kolom qty/satuan/harga yang kosong.
  ///
  /// Berbeda dari GRUP: grup memikul subtotal dan dipakai saat bagiannya memang
  /// perlu dijumlahkan sendiri. Judul cuma tulisan pemisah, dan boleh berkali-
  /// kali dalam satu grup.
  judul                 Boolean                 @default(false)
  deskripsi             String                  @db.Text
  satuan                String?
  qty                   Decimal                 @default(1) @db.Decimal(14, 2)
  harga                 Decimal                 @default(0) @db.Decimal(18, 2)
  diskon_persen         Decimal                 @default(0) @db.Decimal(5, 2)
  jumlah                Decimal                 @default(0) @db.Decimal(18, 2)
  // Dicentang = ikut dasar pengenaan PPh saat `pph_dasar = "item"`.
  kena_pph              Boolean                 @default(false)
  quotation_item_gambar quotation_item_gambar[]

  @@index([quotation_id, urut])
}

/// Kelompok item di dalam satu penawaran — "Alat Elektronik", "Jasa Instalasi",
/// atau "Opsi A" / "Opsi B" kalau penawarannya berisi pilihan.
///
/// Selalu ada minimal satu grup; item tanpa grup tidak pernah tersimpan. Grup
/// inilah yang memikul subtotal, dan ketika `tampilkan_grand_total` mati,
/// subtotal grup adalah satu-satunya angka yang tercetak.
model quotation_grup {
  id             Int              @id @default(autoincrement())
  quotation_id   Int
  quotation      quotation        @relation(fields: [quotation_id], references: [id], onDelete: Cascade)
  urut           Int
  nama           String
  subtotal       Decimal          @default(0) @db.Decimal(18, 2)
  quotation_item quotation_item[]

  @@index([quotation_id, urut])
}

/// Gambar milik SATU PENAWARAN, bukan satu item.
///
/// Item ditulis ulang seluruhnya setiap kali penawaran disunting (lihat
/// QuotationController::ubah), jadi kalau gambar digantung ke `item_id` ia ikut
/// hilang setiap kali disimpan. Karena itu berkasnya milik penawaran, dan
/// kaitannya ke item ditaruh di tabel penghubung yang ikut ditulis ulang.
///
/// `quotation_id` boleh NULL: saat membuat penawaran baru, gambar sudah
/// diunggah sebelum penawarannya punya id sama sekali. Baris seperti itu
/// "yatim", dimiliki pengunggahnya lewat `created_by`, dan diklaim penawaran
/// saat disimpan. Yang tidak pernah diklaim dibersihkan belakangan.
model quotation_gambar {
  id                    Int                     @id @default(autoincrement())
  quotation_id          Int?
  quotation             quotation?              @relation(fields: [quotation_id], references: [id], onDelete: Cascade)
  uuid                  String                  @unique @default(uuid())
  nama_asli             String
  tipe                  String
  ukuran                Int
  created_by            Int?
  created_at            DateTime?               @db.DateTime(0)
  quotation_item_gambar quotation_item_gambar[]

  @@index([quotation_id])
  @@index([created_by, quotation_id])
}

/// Kaitan item ke gambar, beserta urutan tampilnya di baris item itu.
model quotation_item_gambar {
  id        Int              @id @default(autoincrement())
  item_id   Int
  item      quotation_item   @relation(fields: [item_id], references: [id], onDelete: Cascade)
  gambar_id Int
  gambar    quotation_gambar @relation(fields: [gambar_id], references: [id], onDelete: Cascade)
  urut      Int

  @@unique([item_id, gambar_id])
  @@index([item_id, urut])
}

// ============================================================================
// PURCHASE ORDER
// ============================================================================
//
// Dua dokumen berbeda yang sama-sama bernama "PO", dan sengaja dipisah jadi dua
// tabel karena arahnya berlawanan:
//
// - `po_masuk`  — PO yang DITERIMA dari customer. Kita tidak membuatnya; yang
//   disimpan cuma arsipnya (berkas PDF/scan) beserta kaitannya ke penawaran
//   kita. Tidak punya item: yang mengikat adalah berkas dari customer, dan
//   mengetik ulang isinya cuma menciptakan versi kedua yang bisa berbeda.
// - `po_keluar` — PO yang KITA terbitkan ke pemasok. Punya item, dinomori
//   sendiri, dan dicetak jadi PDF seperti quotation.
//
// Sistem lama (`sistempanji`) menyebut keduanya "Data Purchase Order" di dua
// menu (`data_po` dan `data_po2`) tanpa penjelasan mana yang mana — yang ini
// menamai arahnya, supaya tidak perlu membuka isinya untuk tahu.
//
// TIDAK ADA tabel `supplier`. Pemasok pada `po_keluar` diambil dari `customer`,
// master yang sama dengan quotation — begitulah sistem lama bekerja dan begitu
// pula datanya datang: `tb_po2.cust_id` berisi `CUST-054`, id baris
// `tb_customer`, dan grep `tb_supplier` di seluruh `sistempanji` hasilnya nol.
// 730 dari 735 PO lamanya cocok ke `customer.kode` yang sudah diimpor ke sini.
//
// Konsekuensinya satu baris `customer` bisa berperan dua arah — yang kita tagih
// lewat quotation, yang kita bayar lewat po_keluar — dan kodenya dipakai
// bersama: `PJ-Q-SCH-26-0001` dan `PJ-PO-SCH-26-0001` menunjuk perusahaan yang
// sama. Itu justru yang diinginkan: satu perusahaan satu kode, apa pun arah
// transaksinya.

/// PO yang diterima DARI customer — arsip, bukan dokumen yang kita susun.
///
/// Nomornya milik customer dan diketik apa adanya: ia identitas dokumen mereka,
/// jadi tidak boleh dinormalkan, dinomori ulang, atau "dirapikan".
///
/// `quotation_id` opsional. PO yang datang tanpa penawaran itu hal biasa
/// (pesanan ulang, pengadaan kecil), dan memaksa setiap PO menunjuk penawaran
/// akan membuat orang mengarang kaitan supaya formnya bisa disimpan.
model po_masuk {
  id           Int         @id @default(autoincrement())
  uuid         String      @unique @default(uuid())
  /// Nomor PO milik customer. Unik, karena satu nomor PO fisik cuma ada satu —
  /// dua baris dengan nomor sama berarti salah satunya salah input.
  nomor        String      @unique
  tanggal      DateTime    @db.Date
  customer_id  Int
  customer     customer    @relation(fields: [customer_id], references: [id])
  /// Penawaran yang dijawab PO ini. NULL = PO datang tanpa penawaran.
  quotation_id Int?
  quotation    quotation?  @relation(fields: [quotation_id], references: [id])
  perihal      String?
  /// Nama orang di pihak customer yang meminta/menerbitkan PO ini.
  requestor    String?
  /// Nilai PO menurut dokumen customer. Opsional — sebagian PO datang tanpa
  /// nominal (rate card, pesanan bertahap), dan nol yang dipaksakan akan
  /// terbaca sebagai "PO senilai nol".
  nilai        Decimal?    @db.Decimal(18, 2)
  currency     String      @default("IDR")
  catatan      String?     @db.Text
  created_by   Int?
  created_at   DateTime?   @db.DateTime(0)
  updated_at   DateTime?   @db.DateTime(0)
  is_deleted   Boolean     @default(false)
  berkas       po_berkas[]

  @@index([tanggal])
  @@index([customer_id])
  @@index([quotation_id])
}

/// Berkas arsip milik satu `po_masuk` — scan PO, lampiran, halaman tambahan.
///
/// `po_masuk_id` boleh NULL dengan alasan yang sama seperti `quotation_gambar`:
/// form create mengunggah sebelum barisnya punya id. Baris seperti itu yatim,
/// dimiliki pengunggahnya lewat `created_by`, dan diklaim saat disimpan.
///
/// Berbeda dari `quotation_gambar`, isinya TIDAK diperkecil atau di-encode
/// ulang. Ini dokumen arsip — yang disimpan harus byte yang sama dengan yang
/// dikirim customer, karena suatu saat ia dipakai membuktikan apa yang dipesan.
model po_berkas {
  id          Int       @id @default(autoincrement())
  po_masuk_id Int?
  po_masuk    po_masuk? @relation(fields: [po_masuk_id], references: [id], onDelete: Cascade)
  uuid        String    @unique @default(uuid())
  nama_asli   String
  /// MIME asli, dipakai saat berkasnya dilayani kembali. Disimpan karena
  /// ekstensi tidak cukup: PDF dan XLSX sama-sama perlu header yang benar
  /// supaya browser membukanya, bukan mengunduhnya sebagai berkas tak dikenal.
  tipe        String
  ukuran      Int
  created_by  Int?
  created_at  DateTime? @db.DateTime(0)

  @@index([po_masuk_id])
  @@index([created_by, po_masuk_id])
}

/// PO yang KITA terbitkan ke pemasok.
///
/// Lawan transaksinya `customer`, bukan tabel `supplier` tersendiri — lihat
/// catatan di kepala bagian PURCHASE ORDER di atas. Di layar dan di cetakan ia
/// tetap disebut "supplier", karena itu perannya pada dokumen ini.
///
/// Susunan nominalnya sama persis dengan `quotation` (subtotal → diskon → dpp →
/// ppn → pph → total) supaya kedua dokumen bisa dibaca dan dicocokkan dengan
/// cara yang sama, dan supaya rumusnya cuma ada satu bentuk untuk diingat.
///
/// Yang SENGAJA tidak ikut dari quotation:
///
/// - **Grup item.** Quotation punya grup karena ia kadang menawarkan pilihan
///   paket ("Opsi A" / "Opsi B") yang tidak boleh dijumlahkan. PO tidak pernah
///   menawarkan pilihan — ia perintah beli, dan semua barisnya dibeli. Grup di
///   sini cuma satu tingkat sarang tanpa arti.
/// - **`berlaku_sampai` / `kadaluarsa`.** PO tidak kadaluarsa; ia dipenuhi atau
///   dibatalkan, dan keduanya terjadi di luar aplikasi ini.
///
/// Yang ikut: `revisi` (diisi user, bukan hitungan sistem) dan `currency`
/// (penentu simbol, bukan kurs) — keduanya dengan alasan yang sama seperti di
/// quotation.
model po_keluar {
  id                Int              @id @default(autoincrement())
  uuid              String           @unique @default(uuid())
  nomor             String           @unique
  revisi            Int              @default(0)
  tanggal           DateTime         @db.Date
  customer_id       Int
  customer          customer         @relation(fields: [customer_id], references: [id])
  attn              String?
  perihal           String
  /// Kapan barang/jasanya diminta sampai. Opsional: sebagian PO jasa tidak
  /// punya tanggal kirim tunggal.
  tanggal_kirim     DateTime?        @db.Date
  syarat_pembayaran String?          @db.Text
  catatan           String?          @db.Text
  subtotal          Decimal          @default(0) @db.Decimal(18, 2)
  diskon_persen     Decimal          @default(0) @db.Decimal(5, 2)
  diskon_nominal    Decimal          @default(0) @db.Decimal(18, 2)
  dpp               Decimal          @default(0) @db.Decimal(18, 2)
  ppn_persen        Decimal          @default(0) @db.Decimal(5, 2)
  ppn_nominal       Decimal          @default(0) @db.Decimal(18, 2)
  /// PPh dipotong KITA sebagai pembeli dan disetorkan atas nama pemasok, jadi
  /// ia mengurangi yang dibayarkan: total = dpp + ppn - pph. Arahnya kebetulan
  /// sama dengan quotation, tapi alasannya terbalik — di sana kitalah yang
  /// dipotong. Legacy `data_po2` memakai tarif 2% yang dipatok mati lewat
  /// pilihan "Service: Yes/No"; di sini tarifnya diketik, karena PPh 23 punya
  /// tarif lain dan NPWP yang tidak ada menggandakannya.
  pph_persen        Decimal          @default(0) @db.Decimal(5, 2)
  pph_dasar         String           @default("item")
  pph_nominal       Decimal          @default(0) @db.Decimal(18, 2)
  total             Decimal          @default(0) @db.Decimal(18, 2)
  currency          String           @default("IDR")
  /// Penanda tangan yang tercetak di blok "Ordered by". Opsional, dengan alasan
  /// yang sama seperti di quotation.
  ttd_id            Int?
  ttd               ttd?             @relation(fields: [ttd_id], references: [id])
  created_by        Int?
  created_at        DateTime?        @db.DateTime(0)
  updated_at        DateTime?        @db.DateTime(0)
  is_deleted        Boolean          @default(false)
  po_keluar_item    po_keluar_item[]

  @@index([tanggal])
  @@index([customer_id])
  @@index([ttd_id])
}

model po_keluar_item {
  id            Int       @id @default(autoincrement())
  po_keluar_id  Int
  po_keluar     po_keluar @relation(fields: [po_keluar_id], references: [id], onDelete: Cascade)
  urut          Int
  /// Baris JUDUL, bukan barang — sama artinya dengan `quotation_item.judul`:
  /// hanya `deskripsi` yang berarti, angkanya dipaksa nol, dan ia tidak
  /// kebagian nomor urut.
  judul         Boolean   @default(false)
  deskripsi     String    @db.Text
  satuan        String?
  qty           Decimal   @default(1) @db.Decimal(14, 2)
  harga         Decimal   @default(0) @db.Decimal(18, 2)
  diskon_persen Decimal   @default(0) @db.Decimal(5, 2)
  jumlah        Decimal   @default(0) @db.Decimal(18, 2)
  /// Dicentang = ikut dasar pengenaan PPh saat `pph_dasar = "item"`.
  kena_pph      Boolean   @default(false)
  /// Keterangan singkat per baris (nomor part, lead time, merek yang diminta).
  /// Ada di sistem lama sebagai `item_remarks` dan ikut tercetak di PDF-nya —
  /// dipertahankan karena kolom itu memang dipakai, bukan warisan kosong.
  remarks       String?

  @@index([po_keluar_id, urut])
}
